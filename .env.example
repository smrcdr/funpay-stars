# Заполняется командой: uv run funpay-stars wallet-create
WALLET_MNEMONIC=

# Необязательно, но без ключа toncenter режет до 1 rps. Ключ: @tonapibot в Telegram
TONCENTER_API_KEY=

# Куки fragment.com после входа через Telegram + подключения ЭТОГО кошелька (DevTools → Application → Cookies)
FRAGMENT_STEL_SSID=
FRAGMENT_STEL_TOKEN=
FRAGMENT_STEL_TON_TOKEN=
FRAGMENT_STEL_DT=-180

# Защита: максимум TON на один заказ
MAX_TON_PER_ORDER=10

# Токен для HTTP API: uv run funpay-stars gen-token
API_TOKEN=
